{
  "name": "consulta-dev/autofill-laravel-example",
  "description": "Executable same-origin bridge example for Consulta Autofill.",
  "type": "project",
  "license": "Apache-2.0",
  "require": {
    "php": "^8.2"
  },
  "require-dev": {
    "orchestra/testbench": "^10.11"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit --configuration phpunit.xml"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
