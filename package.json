{
  "name": "@consulta-dev/workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Public source for Consulta Autofill.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=24.0.0 <27.0.0",
    "pnpm": ">=11.5.0 <12.0.0"
  },
  "scripts": {
    "build": "pnpm --filter @consulta-dev/qr-engine run build && pnpm --filter @consulta-dev/autofill run build && pnpm --filter @consulta-dev/embed run build && pnpm embed:verify-versioned",
    "embed:verify-versioned": "node ./apps/embed/scripts/verify-versioned-build.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "benchmark": "pnpm --filter @consulta-dev/qr-engine run benchmark",
    "release:prepare": "node ./scripts/prepare-release-artifacts.mjs",
    "release:verify": "node ./scripts/verify-release-artifacts.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.9.1",
    "globals": "^17.12.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.1.0",
    "vitest": "^4.1.11"
  }
}
